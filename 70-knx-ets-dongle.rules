# KNX ETS license stick (2a07:0102), forwarded from `dongle-host` over USB/IP by RUDY.
#
# The vhci-hcd-attached device lands with a root-only /dev/hidraw node, so Wine
# (running as a normal desktop user) cannot enumerate it and ETS5 reports no
# dongle even though lsusb shows it.
#
# GROUP=plugdev is the deterministic grant. TAG+="uaccess" additionally lets
# systemd-logind add an ACL for the active seat user; it is not relied upon,
# because the device hangs off /sys/devices/platform/vhci_hcd.0 and arrives
# tagged "seat" without an ID_SEAT.
#
# Scoped to this single VID:PID so no other USB or HID device is affected.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2a07", ATTRS{idProduct}=="0102", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="2a07", ATTR{idProduct}=="0102", MODE="0660", GROUP="plugdev", TAG+="uaccess"
