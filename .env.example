# Hostname or address of the machine the license stick is plugged into.
USBIP_SERVER=dongle-host.example
USBIP_PORT=3240

# LAN address of that same machine. The server listens only here.
# Do not use 0.0.0.0.
USBIP_BIND_ADDRESS=192.0.2.10

# KNX ETS license stick. This VID:PID is the whole filter; do not pin a bus id.
USBIP_DEVICE_IDS=2a07:0102

TZ=Europe/Berlin

# Optional, and different on each machine. Leave empty to run USB/IP with no MQTT.
# This string is a secret: it contains the broker password.
# Quote it: the value contains spaces.
# Workstation example:  MQTT_OPTIONS="-h mqtt.example -u rudy-client -P replace-me"
# Dongle-host example:  MQTT_OPTIONS="-h mqtt.example -u rudy-server -P replace-me"
# The client reloads when rudy/server/start is published.
# The server reloads when rudy/client/error/server is published.
MQTT_OPTIONS=
